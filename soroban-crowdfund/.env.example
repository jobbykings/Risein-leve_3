# Deployment configuration for the crowdfund contract.
# Copy this file to `.env` (run `make init`) and fill in the values.

# --- Required --------------------------------------------------------------

# Your funded testnet account. Either the secret key (S...) or the alias you
# created with:  stellar keys add <alias>
STELLAR_SOURCE=

# Address (G...) that receives the raised funds when the campaign is claimed.
BENEFICIARY=

# --- Optional (defaults shown) ----------------------------------------------

# Network to deploy to: testnet | futurenet   (mainnet is refused by the script)
# STELLAR_NETWORK=testnet

# Funding target in stroops. 1 XLM = 10,000,000 stroops.
# Default: 100000000000000 (10,000 XLM)
# TARGET_STROOPS=100000000000000

# Campaign deadline as a Unix timestamp (seconds).
# Default: now + 30 days
# DEADLINE_UNIX=

# Token contract the campaign accepts. Defaults to the native XLM SAC on testnet.
# TOKEN_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
